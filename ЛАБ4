#include <iostream>
using namespace std;

const int N = 100;

int main() {
    int a[N], n, k, i, j, t, m, tmp;

    cout << "Количество элементов (1.." << N << "): ";
    cin >> n;
    cout << "Номер K (1..n): ";
    cin >> k;

    if (n >= 1 && n <= N && k >= 1 && k <= n) {

        // 1) создание кольца в массиве
        cout << "Элементы кольца: ";
        for (i = 0; i < n; ++i) {
            cin >> a[i];
        }

        // 2) печать, начиная с K-го элемента до (K-1)-го
        cout << "Исходное кольцо: ";
        for (t = 0; t < n; ++t) {
            cout << a[(k - 1 + t) % n] << " ";
        }
        cout << endl;

        // 3) упорядочивание по возрастанию (пузырёк)
        for (i = 0; i < n - 1; ++i) {
            for (j = 0; j < n - 1 - i; ++j) {
                if (a[j] > a[j + 1]) {
                    tmp = a[j];
                    a[j] = a[j + 1];
                    a[j + 1] = tmp;
                }
            }
        }

        // 4) удаление чётных элементов
        m = 0;
        for (i = 0; i < n; ++i) {
            if (a[i] % 2 != 0) {
                a[m] = a[i];
                ++m;
            }
        }
        n = m;

        if (n > 0) {
            // если K вышло за новую длину, переходим по кольцу
            if (k > n) {
                k = (k - 1) % n + 1;
            }

            // 5) печать, начиная с K-го элемента до (K-1)-го
            cout << "Результат: ";
            for (t = 0; t < n; ++t) {
                cout << a[(k - 1 + t) % n] << " ";
            }
            cout << endl;
        } else {
            cout << "Кольцо пусто" << endl;
        }
    } else {
        cout << "Ошибка ввода" << endl;
        return 1;
    }

    return 0;
