#include <iostream>
#include <cmath>    // Подключаем библиотеку для математических функций (exp, sqrt)
#include <clocale>  // Для корректного отображения русского языка в консоли

using namespace std;

int main() {
    // Устанавливаем русский язык для консоли
    setlocale(LC_ALL, "Russian");

    double sum = 0.0; // Переменная для накопления суммы (вещественное число)

    // Выводим заголовок по заданию
    cout << "--- Лабораторная работа №2. Вариант 24 ---" << endl;
    cout << "Вычисление суммы 9 членов ряда: a_n = e^(-sqrt(n))" << endl;
    cout << "-------------------------------------------------" << endl;

    // Цикл с параметром: n изменяется от 1 до 9 (всего 9 раз)
    for (int n = 1; n <= 9; n++) {
        
        // Вычисляем текущий член ряда: e в степени минус корень из n
        double a = exp(-sqrt(n)); 
        
        // Добавляем текущий член к общей сумме
        sum += a; 
        
        // Выводим промежуточный результат (полезно для проверки)
        cout << "Шаг " << n << ": a_n = " << a << "\tТекущая сумма = " << sum << endl;
    }

    // Выводим итоговый результат (снабжаем заголовком, как требуется в задании)
    cout << "-------------------------------------------------" << endl;
    cout << "ИТОГОВЫЙ РЕЗУЛЬТАТ: Сумма 9 членов ряда = " << sum << endl;

    return 0;
}
