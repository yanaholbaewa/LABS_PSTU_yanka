#include <iostream>
using namespace std;

const int MAX = 100;

int countElements(int a[][MAX], int n, int m)
{
    int maxDiag = a[0][0];

    for (int i = 1; i < n && i < m; i++)
    {
        if (a[i][i] > maxDiag)
        {
            maxDiag = a[i][i];
        }
    }

    int count = 0;

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < m; j++)
        {
            if (a[i][j] > maxDiag)
            {
                count++;
            }
        }
    }

    return count;
}

int main()
{
    int n, m;
    int a[MAX][MAX];

    cout << "Enter n and m: ";
    cin >> n >> m;

    if (n <= 0 || m <= 0 || n > MAX || m > MAX)
    {
        cout << "Error";
        return 0;
    }

    cout << "Enter array elements:" << endl;

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < m; j++)
        {
            cin >> a[i][j];
        }
    }

    cout << "Array:" << endl;

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < m; j++)
        {
            cout << a[i][j] << "\t";
        }
        cout << endl;
    }

    int result = countElements(a, n, m);

    cout << "Result: " << result << endl;

    return 0;
}
