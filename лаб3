#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

int main() {
    double a = -2.0;      // Начало интервала x
    double b = 0.0;       // Конец интервала x
    int k = 10;           // Количество шагов
    int N = 40;           // Количество слагаемых для суммы SN
    double e = 0.0001;    // Точность для суммы SE

    
    double h = (b - a) / k; // Шаг
    double x, y;            // Текущий x и точное значение y
    double ch;              // Текущий член ряда
    double SN = 0.0;        // Сумма с фиксированным количеством слагаемых
    double SE = 0.0;        // Сумма с заданной точностью
    int n;                  // Счетчик для циклов

   
    cout << "Вычисление функции y = ln(1 / (2 + 2x + x^2))\n";
    cout << "----------------------------------------------------------\n";
    cout << setw(8) << "X" 
         << setw(12) << "SN (N=40)" 
         << setw(12) << "SE (eps)" 
         << setw(12) << "Точное Y" << "\n";
    cout << "----------------------------------------------------------\n";

    // --- 2. Внешний цикл (арифметический, по x) ---
    // Идем от a до b. Добавляем h/2.0, чтобы избежать ошибок округления 
    // и гарантированно попасть в конечную точку b.
    for (x = a; x <= b + h / 2.0; x = x + h) {
        
        // Вычисляем точное значение функции
        y = log(1.0 / (2.0 + 2.0 * x + x * x));

        // --- 3. Вычисление суммы SN (цикл for) ---
        SN = 0.0;
        ch = -(1.0 + x) * (1.0 + x); // Первый член ряда (n=1)
        
        for (n = 1; n <= N; n++) {
            SN = SN + ch;
            // Рекуррентная формула для следующего члена
            ch = ch * (-1.0 * (1.0 + x) * (1.0 + x) * n / (n + 1.0));
        }

        // --- 4. Вычисление суммы SE (цикл while) ---
        SE = 0.0;
        ch = -(1.0 + x) * (1.0 + x); // Сбрасываем на первый член
        n = 1;
        
        while (abs(ch) >= e) {
            SE = SE + ch;
            // Рекуррентная формула для следующего члена
            ch = ch * (-1.0 * (1.0 + x) * (1.0 + x) * n / (n + 1.0));
            n++;
        }

        // --- 5. Вывод результатов для текущего x ---
        // fixed и setprecision(4) нужны для красивого вывода (4 знака после запятой)
        cout << fixed << setprecision(4) 
             << setw(8) << x 
             << setw(12) << SN 
             << setw(12) << SE 
             << setw(12) << y << "\n";
    }

    return 0;
}
